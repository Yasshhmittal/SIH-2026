# NEBULA Prototype — Environment variables
# All values below are the DEFAULTS already baked into the code. This file is
# documentation + an override surface: export any of these in your shell to
# override the default (the code reads them via os.getenv). There is no cloud
# API key anywhere — NEBULA runs fully local against Ollama.

# ── Ollama model tags (must match `ollama list`) ─────────
# These are Ollama model names, NOT HuggingFace repo IDs.
QWEN_TEXT_MODEL=qwen2.5:7b
QWEN_VL_MODEL=qwen2.5vl:7b
BGE_MODEL=bge-m3:latest

# ── Ollama call timeouts (seconds) ───────────────────────
# Generous by design: cover cold model load + generation on an Apple M4.
# A hung server then fails cleanly instead of freezing the demo.
OLLAMA_HEALTH_TIMEOUT=5     # startup preflight probe (fail fast)
OLLAMA_CHAT_TIMEOUT=300     # Qwen2.5-7B reasoning
OLLAMA_EMBED_TIMEOUT=120    # BGE-M3 embeddings
OLLAMA_VL_TIMEOUT=360       # Qwen2.5-VL vision (slowest, most memory-sensitive)

# ── Qwen generation settings ─────────────────────────────
MAX_NEW_TOKENS=1024
TEMPERATURE=0.1

# ── Paths (relative to project root) ─────────────────────
CACHE_DIR=./cache               # embedding index cache (.npy)
LOGS_DIR=./logs                 # append-only event log (events.jsonl)
ARTIFACTS_OUTPUT_DIR=./output   # generated approval-note DOCX files

# ── Note on memory safety (do not weaken) ────────────────
# Models are loaded ONE AT A TIME and evicted with keep_alive=0 after each
# phase, so peak RAM stays near a single 7B model. This is deliberate for the
# 16 GB M4 target; see models/*.py unload().

# ── Note on retrieval threshold ──────────────────────────
# The RAG similarity floor (SIMILARITY_THRESHOLD = 0.35) is a code constant in
# core/validator.py, not an env var. Below it, the agent refuses rather than
# grounding on weak evidence.
